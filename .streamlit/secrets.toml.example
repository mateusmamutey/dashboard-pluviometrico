# Copie para .streamlit/secrets.toml (que NÃO vai para o git) ou cole
# no Streamlit Cloud em Settings → Secrets.

# Conexão com o Google Sheets (a mesma de antes)
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/..."
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# Token do LI-COR Cloud: licor.cloud → Data → API (limite de 5 por titular)
[licor]
token = "cole-o-token-aqui"

# Opcional: valores padrão da configuração. A aba "config" da planilha,
# se existir, vence o que estiver aqui.
[pluviometro]
capacidade_mm = 192
faixa_atencao_pct = 50
faixa_urgente_pct = 75
